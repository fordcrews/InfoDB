# Copy to .env and adjust for your environment

POSTGRES_USER=infodb
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=infodb
POSTGRES_HOST=db
POSTGRES_PORT=5432

DATABASE_URL=postgresql+asyncpg://infodb:change_me_in_production@db:5432/infodb

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# First admin user (created by seed script)
ADMIN_EMAIL=admin@local.dev
ADMIN_PASSWORD=change_me_on_first_login

API_CORS_ORIGINS=http://localhost:5173,http://localhost:3000